<?xml version="1.0" encoding="utf-8"?>
<!-- Icône de l'appli (décisions 71 et 72) : Tilou au pop-corn, comme le logo
     du site, sur le mauve du canapé. Icône « adaptative » : chaque téléphone
     la découpe à sa forme (rond, carré arrondi…). Pas de version monochrome
     pour l'instant : pour les icônes « à thème », Android affiche l'icône en
     couleur avant Android 16 QPR 2, et en fabrique une lui-même ensuite. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_tilou" />
</adaptive-icon>
